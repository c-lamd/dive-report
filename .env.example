# Copy to .env (gitignored). Values with spaces must be quoted; keep comments on their own lines.
# Then: uv run --env-file .env main.py --dry-run

# Your number at your carrier's email-to-SMS gateway (table in README): e.g. 9495551234@vtext.com
SMS_TO=
# The Gmail account that sends
SMTP_USER=
# A Gmail App Password (Google Account > Security > 2-Step Verification > App passwords), quoted because of the spaces
SMTP_PASS="xxxx xxxx xxxx xxxx"
# Optional. Without it the rules engine does the analysis; with it, Claude does.
# ANTHROPIC_API_KEY=sk-ant-...
